# ─────────────────────────────────────────────────────────────────────────────
# BookStack MCP Remote — Environment Configuration
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Internal URL of your BookStack container (Docker network, no TLS overhead)
# If bookstack-mcp runs in the same docker-compose as bookstack, use:
BOOKSTACK_BASE_URL=http://bookstack:80/api
# If running standalone, use your public BookStack URL:
# BOOKSTACK_BASE_URL=https://bookstack.example.com/api

# BookStack API token (Settings → API Tokens → Add Token)
# Format: token_id:token_secret
BOOKSTACK_API_TOKEN=your_token_id:your_token_secret

# Secret key for signing JWT access tokens
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Public HTTPS URL where this MCP server is reachable
# Used in OAuth metadata (/.well-known/oauth-authorization-server)
BASE_URL=https://mcp-bookstack.example.com

# Port the server listens on inside the container
MCP_PORT=3100
